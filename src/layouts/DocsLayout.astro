---
import { Breadcrumbs, CalloutBlock } from '@modcommunity/shared'
import Layout from './Layout.astro'
import DocsNav from '../components/docs/DocsNav'
import DocsToc, { type TocHeading } from '../components/docs/DocsToc'
import Pager from '../components/docs/Pager.astro'
import {
    breadcrumbsFor,
    docHref,
    flattenTree,
    toNavTree,
    type DocNode,
} from '../docs/tree'
import { getT } from '../i18n/t'

type Props = {
    /** Locale-less doc path — `''` for the docs home. */
    path: string
    title: string
    description: string
    tree: DocNode[]
    headings: TocHeading[]
    locale?: string
    badge?: 'new' | 'updated' | 'draft'
    /** True when this locale has no translation and English is being shown. */
    fallback?: boolean
    /** Suppress the prev/next pager — the docs home has nothing before it. */
    pager?: boolean
}

const {
    path,
    title,
    description,
    tree,
    headings,
    locale = 'en',
    badge,
    fallback = false,
    pager = true,
} = Astro.props as Props

const t = getT(locale)

// Reading order, used for the pager. The docs home is not in the tree, so the
// first section index is correctly `next` from it and `prev` from nothing.
const flat = flattenTree(tree)
const index = flat.findIndex((n) => n.path === path)

const prev = index > 0 ? flat[index - 1] : undefined
const next =
    index === -1
        ? flat[0] // the docs home: next is the first section
        : index < flat.length - 1
          ? flat[index + 1]
          : undefined

const trail = breadcrumbsFor(path, tree)

const crumbs = [
    { label: t('docs.home'), href: docHref('', locale) },
    ...trail.map((n) => ({ label: n.navLabel, href: n.href })),
]

const BADGE_TONE = {
    new: 'bg-success/15 text-success',
    updated: 'bg-accent/15 text-accent',
    draft: 'bg-warning/15 text-warning',
} as const
---

<Layout
    pathName={Astro.url.pathname}
    meta={{
        title,
        titleMain: `${title} - ${t('docs.brand')}`,
        desc: description,
    }}
>
    <!--
        `flex-wrap`, and see the `.docs-shell > astro-island` rule in
        `styles/components/Docs.css`.

        <DocsNav/> is ONE island holding two things that have to be placed
        differently: the wide-viewport rail, which is a column BESIDE the
        article, and the narrow-viewport trigger bar, which is a strip ABOVE it.
        Astro wraps an island's output in a single `<astro-island>` element, so
        without those two rules that wrapper becomes one flex item containing
        both — and at 390px the trigger bar's intrinsic width squeezed the
        article column to zero and pushed the page 258px wide.
    -->
    <div class="docs-shell mx-auto flex w-full max-w-[105rem] flex-wrap gap-8 px-4 py-8 @3xl:px-8">
        <DocsNav
            tree={toNavTree(tree)}
            activePath={path}
            locale={locale}
            client:load
        />

        <!--
            The article column opens its OWN container. Everything inside it —
            endpoint tables, the parameter grids, the code samples — sizes off
            the prose width, not off `<main>`, which is ~17rem wider here
            because of the docs rail beside it. `min-w-0` is what stops one long
            unbreakable line (a JWT, a curl one-liner) from widening the column
            and pushing a scrollbar onto the whole page instead of scrolling
            inside its own block.
        -->
        <div class="@container min-w-0 flex-1">
            <Breadcrumbs items={crumbs} className="mb-4" />

            <header class="mb-8">
                {
                    badge && (
                        <span
                            class:list={[
                                'mb-2 inline-block rounded px-2 py-0.5 font-pjs text-xs font-semibold uppercase tracking-wide',
                                BADGE_TONE[badge],
                            ]}
                        >
                            {t(`docs.badge.${badge}`)}
                        </span>
                    )
                }

                <h1
                    class="font-pjs text-3xl font-bold tracking-tight text-foreground @2xl:text-4xl"
                >
                    {title}
                </h1>
                <p class="mt-3 text-lg text-muted">{description}</p>
            </header>

            {
                fallback && (
                    <CalloutBlock tone="neutral" className="mb-8">
                        <p set:html={t('docs.fallback')} />
                    </CalloutBlock>
                )
            }

            <article class="docs-prose">
                <slot />
            </article>

            {pager && <Pager prev={prev} next={next} locale={locale} />}
        </div>

        <!--
            "On this page". Appears last of the three columns and first to go:
            it is the only one that is purely an accelerator — every heading it
            links to is a few centimetres further down the same page.
        -->
        <aside class="hidden shrink-0 @6xl:block @6xl:w-[14rem]">
            <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pb-8">
                <DocsToc headings={headings} locale={locale} client:visible />
            </div>
        </aside>
    </div>
</Layout>
