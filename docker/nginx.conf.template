# Rendered to /etc/nginx/conf.d/default.conf at container start — the nginx
# image's entrypoint fills in the listen port from the environment, and nothing
# else (see NGINX_ENVSUBST_FILTER in docker-compose.yml), before nginx reads it.
# Do not name that variable in prose here: envsubst rewrites comments too.
#
# This is the INNER server. The host's nginx terminates TLS and routes both
# `^/learn` and `^/(es|fr|de|ru|nl|ja|zh|pt)/learn` here; everything below
# assumes the request arrives with that prefix intact, which is also the shape
# `dist/` is in.
server {
    listen ${INTERNAL_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Every URL on this site carries a trailing slash (Astro's `directory`
    # output), so nginx answers the bare path with a 301. Keep that redirect
    # relative: with absolute_redirect on — the default — nginx would send the
    # client its own container address and port instead of the public one.
    absolute_redirect off;

    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Hashed build chunks: the filename changes whenever the contents do, so
    # they can be cached forever. Under /learn rather than at the root — see
    # `build.assets` in astro.config.mjs, which moves them there so they cannot
    # collide with website-processing's own /_astro/ on the same domain.
    location /learn/_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # The per-locale search indexes. Fetched on a reader's first keystroke, not
    # at page load, and rebuilt on every deploy — so cache them, but briefly.
    location /learn/search/ {
        add_header Cache-Control "public, max-age=3600, must-revalidate";
        access_log off;
    }

    # This container owns no `/`. On the real domain that path is
    # website-processing's landing page and the host nginx never routes it
    # here — but a deploy check is `curl http://127.0.0.1:<port>`, and sending
    # that to the docs root beats answering it with a 404. 302, not 301:
    # nothing should cache a redirect out of a path this build does not own.
    location = / {
        return 302 /learn/;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Astro's directory output builds src/pages/learn/404.astro to
    # learn/404/index.html, NOT 404.html — the same path the host nginx aims
    # its own `error_page 404` at. English only, because a locale tree can only
    # overlay pages onto the English one and none of them carries a 404.
    #
    # `error_page` rather than a try_files fallback: a fallback would serve the
    # page with a 200, which is exactly what you do not want a crawler to see.
    error_page 404 /learn/404/index.html;
}
